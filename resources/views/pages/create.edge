@layout.main({ title: "Maak je CV!" })
  @slot('main')
    <div class="pt-4 h-full flex flex-col mt-8 ">
      <form
        x-data="cvForm()"
        x-init="loadData()"
        @submit="saveData()"
        class="max-w-3xl mx-auto p-6 bg-purple-800 rounded-lg shadow-md space-y-8"
        data-turbo="false"
        method="POST"
        action="/generate"
        enctype="multipart/form-data"
      >
        {{ csrfField() }}

        @include('partials/template_previews')

        <fieldset class="border border-purple-700 rounded-md p-4">
          <legend class="text-xl font-semibold mb-0">Persoonlijke info</legend>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 relative bg-purple-700 border border-purple-600 p-4 rounded-md ">
            <div>
              <label for="first_name" class="block text-sm font-medium text-white mb-1">Voornaam</label>
              <input
                type="text"
                id="first_name"
                name="first_name"
                class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                x-model="first_name"
                required
              />
            </div>

            <div>
              <label for="last_name" class="block text-sm font-medium text-white mb-1">Achternaam</label>
              <input
                type="text"
                id="last_name"
                name="last_name"
                class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                x-model="last_name"
                required
              />
            </div>

            <div>
              <label for="birthdate" class="block text-sm font-medium text-white mb-1">Geboortedatum</label>
              <input
                type="date"
                id="birthdate"
                name="birthdate"
                class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                x-model="birthdate"
                required
              />
            </div>

            <div>
              <label for="city" class="block text-sm font-medium text-white mb-1">Woonplaats</label>
              <input
                type="text"
                id="city"
                name="city"
                class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                x-model="city"
                required
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-white mb-1">Mobiele telefoon</label>
              <input
                type="text"
                id="phone"
                name="phone"
                class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                x-model="phone"
                required
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-white mb-1">Email adres</label>
              <input
                type="email"
                id="email"
                name="email"
                class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                x-model="email"
                required
              />
            </div>

            <div>
              <label for="photo" class="block text-sm font-medium text-white mb-1">Foto</label>
              <input
                type="file"
                id="photo"
                name="photo"
                accept="image/*"
                class="w-full text-white file:bg-purple-700 file:text-white file:border-0 file:px-3 file:py-1.5 file:rounded-md file:cursor-pointer"
                @change="fileChanged($event)"
              />
            </div>
          </div>
        </fieldset>

        <fieldset class="border border-purple-700 rounded-md p-4">
          <legend class="text-xl font-semibold mb-0">Profiel</legend>
          <div class="relative bg-purple-700 border border-purple-600 p-4 rounded-md space-y-2">
            <div class="md:col-span-2">
              <label for="job_title" class="block text-sm font-medium text-white mb-1">Werk titel</label>
              <input
                type="text"
                id="job_title"
                name="job_title"
                class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                x-model="job_title"
                placeholder="Voor welke baan is dit? Elektromonteur? Schoonmaker?"
                required
              />
            </div>

            <div class="md:col-span-2">
              <label for="profile" class="block text-sm font-medium text-white mb-1">Je beschrijving</label>
              <textarea
                id="profile"
                name="profile"
                rows="5"
                placeholder="Schrijf een korte alinia over jezelf"
                class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none resize-none"
                x-model="profile"
                required
              ></textarea>
            </div>
          </div>
        </fieldset>

        <fieldset class="border border-purple-700 rounded-md px-4 pb-4 space-y-4" x-data>
          <legend class="text-xl font-semibold mb-0">Hobby's & Interesses</legend>

          <template x-for="(hobby, index) in hobbies" :key="index">
            <div class="space-y-4 border border-purple-600 p-4 rounded-md relative bg-purple-700">
              <button
                type="button"
                x-show="hobbies.length > 1"
                @click="hobbies.splice(index, 1)"
                class="absolute top-2 right-2 text-red-400 hover:text-red-600"
                title="Verwijder deze hobby"
              >
                🗑️
              </button>

              <div>
                <label class="block text-sm font-medium text-white mb-1">Hobby of interesse</label>
                <input
                  type="text"
                  :name="`hobby[${index}]`"
                  placeholder="Bijv. Programmeren, Gamen, Wandelen"
                  class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                  x-model="hobbies[index].name"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-white mb-1">Beschrijving</label>
                <textarea
                  :name="`hobby_description[${index}]`"
                  rows="3"
                  placeholder="Vertel iets over deze hobby of interesse"
                  class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none resize-none"
                  x-model="hobbies[index].description"
                ></textarea>
              </div>
            </div>
          </template>

          <button
            type="button"
            @click="hobbies.push({ name: '', description: '' })"
            class="mt-2 inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition"
          >
            Hobby toevoegen
          </button>
        </fieldset>

        <fieldset class="border border-purple-700 rounded-md px-4 pb-4 space-y-4" x-data>
          <legend class="text-xl font-semibold mb-0">Werkervaring</legend>

          <template x-for="(experience, index) in experiences" :key="index">
            <div class="space-y-4 border border-purple-600 p-4 rounded-md relative bg-purple-700">
              <button
                type="button"
                x-show="experiences.length > 1"
                @click="experiences.splice(index, 1)"
                class="absolute top-2 right-2 text-red-400 hover:text-red-600"
                title="Verwijder deze werkervaring"
                :required="Object.values(experiences[index]).some(v => v !== '')"
              >
                🗑️
              </button>

              <div>
                <label class="block text-sm font-medium text-white mb-1">Positie</label>
                <input
                  type="text"
                  :name="`position[${index}]`"
                  class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                  x-model="experiences[index].position"
                  placeholder="Voorbeeld: Developer, monteur, secretaresse"
                  :required="Object.values(experiences[index]).some(v => v !== '')"
                />
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="block text-sm font-medium text-white mb-1">Bedrijf</label>
                  <input
                    type="text"
                    :name="`company[${index}]`"
                    class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                    x-model="experiences[index].company"
                    placeholder="Voorbeeld: Albert Heijn"
                    :required="Object.values(experiences[index]).some(v => v !== '')"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-white mb-1">Locatie</label>
                  <input
                    type="text"
                    :name="`location[${index}]`"
                    class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                    x-model="experiences[index].location"
                    placeholder="Voorbeeld: Amsterdam, Nederland"
                    :required="Object.values(experiences[index]).some(v => v !== '')"
                  />
                </div>
                <div class="flex space-x-2">
                  <div class="flex-1">
                    <label class="block text-sm font-medium text-white mb-1">Startdatum</label>
                    <input
                      type="month"
                      :name="`start_date[${index}]`"
                      class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                      x-model="experiences[index].start_date"
                      placeholder="Dec 2017"
                      :required="Object.values(experiences[index]).some(v => v !== '')"
                    />
                  </div>
                  <div class="flex-1">
                    <label class="block text-sm font-medium text-white mb-1">Einddatum</label>
                    <input
                      type="month"
                      :name="`end_date[${index}]`"
                      class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                      x-model="experiences[index].end_date"
                      placeholder="Dec 2018"
                      :required="Object.values(experiences[index]).some(v => v !== '')"
                    />
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-white mb-1">Beschrijving</label>
                <textarea
                  :name="`description[${index}]`"
                  rows="3"
                  class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none resize-none"
                  x-model="experiences[index].description"
                  placeholder="Voorbeeld:&#10;- Het controleren en inpakken van disinfectiemiddelen"
                  :required="Object.values(experiences[index]).some(v => v !== '')"
                ></textarea>
              </div>
            </div>
          </template>

          <button
            type="button"
            @click="experiences.push({ position: '', company: '', location: '', start_date: '', end_date: '', description: '' })"
            class="mt-2 inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition"
          >
            Werkervaring toevoegen
          </button>
        </fieldset>

        <fieldset class="border border-purple-700 rounded-md px-4 pb-4 space-y-4" x-data>
          <legend class="text-xl font-semibold mb-0">Opleiding</legend>

          <template x-for="(education, index) in educations" :key="index" class=" space-y-4">
            <div class="space-y-4 border border-purple-600 p-4 rounded-md relative bg-purple-700">
              <button
                type="button"
                x-show="educations.length > 1"
                @click="educations.splice(index, 1)"
                class="absolute top-2 right-2 text-red-400 hover:text-red-600"
                title="Verwijder deze opleiding"
              >
                🗑️
              </button>

              <div>
                <label class="block text-sm font-medium text-white mb-1">Opleidingstitel</label>
                <input
                  type="text"
                  :name="`degree[${index}]`"
                  class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                  x-model="educations[index].degree"
                  placeholder="Voorbeeld: Master of Science"
                  :required="Object.values(educations[index]).some(v => v !== '')"
                />
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="block text-sm font-medium text-white mb-1">Instelling</label>
                  <input
                    type="text"
                    :name="`institution[${index}]`"
                    class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                    x-model="educations[index].institution"
                    placeholder="Voorbeeld: Universiteit van Amsterdam"
                    :required="Object.values(educations[index]).some(v => v !== '')"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-white mb-1">Locatie</label>
                  <input
                    type="text"
                    :name="`location_edu[${index}]`"
                    class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                    x-model="educations[index].location"
                    placeholder="Voorbeeld: Amsterdam"
                    :required="Object.values(educations[index]).some(v => v !== '')"
                  />
                </div>
                <div class="flex space-x-2">
                  <div class="flex-1">
                    <label class="block text-sm font-medium text-white mb-1">Startdatum</label>
                    <input
                      type="month"
                      :name="`start_date_edu[${index}]`"
                      class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                      x-model="educations[index].start_date"
                      :required="Object.values(educations[index]).some(v => v !== '')"
                    />
                  </div>
                  <div class="flex-1">
                    <label class="block text-sm font-medium text-white mb-1">Einddatum</label>
                    <input
                      type="month"
                      :name="`end_date_edu[${index}]`"
                      class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                      x-model="educations[index].end_date"
                      :required="Object.values(educations[index]).some(v => v !== '')"
                    />
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-white mb-1">Beschrijving</label>
                <textarea
                  :name="`description_edu[${index}]`"
                  rows="3"
                  class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none resize-none"
                  x-model="educations[index].description"
                  placeholder="Voorbeeld:&#10;- Het leren van automatisering&#10;- Leren van probleemoplossend denken"
                  :required="Object.values(educations[index]).some(v => v !== '')"
                ></textarea>
              </div>
            </div>
          </template>

          <button
            type="button"
            @click="educations.push({ degree: '', institution: '', location: '', start_date: '', end_date: '', description: '' })"
            class="mt-2 inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition"
          >
            Opleiding toevoegen
          </button>
        </fieldset>

        <fieldset class="border border-purple-700 rounded-md  px-4 pb-4 space-y-4" x-data>
          <legend class="text-xl font-semibold mb-0 ">Skills</legend>

          <template x-for="(skill, index) in skills" :key="index">
            <div class="relative bg-purple-700 border border-purple-600 p-4 rounded-md space-y-2">
              <button
                type="button"
                x-show="skills.length > 1"
                @click="skills.splice(index, 1)"
                class="absolute top-2 right-2 text-red-400 hover:text-red-600"
                title="Verwijder deze skill"
              >
                🗑️
              </button>

              <div class="flex flex-col md:flex-row md:items-center md:space-x-4">
                <div class="md:flex-1">
                  <label class="block text-sm font-medium text-white mb-1">Skill</label>
                  <input
                    type="text"
                    :name="`skill[${index}]`"
                    placeholder="E.g. JavaScript"
                    class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                    x-model="skills[index].name"
                    :required="Object.values(skills[index]).some(v => v !== '')"
                  />
                </div>

                <div class="md:flex-1 mt-4 md:mt-0">
                  <label class="block text-sm font-medium text-white mb-1">Level</label>
                  <div class="flex items-center space-x-2">
                    <template x-for="lvl in 5" :key="lvl">
                      <button
                        type="button"
                        @click="skills[index].level = lvl"
                        :class="{
                            'bg-blue-600': skills[index].level >= lvl,
                            'bg-purple-900': skills[index].level < lvl
                          }"
                        class="w-8 h-4 rounded transition-colors"
                        :aria-label="'Level ' + lvl"
                        :required="Object.values(skills[index]).some(v => v !== '')"
                      ></button>
                    </template>
                  </div>
                  <input type="hidden" :name="`skill_level[${index}]`" :value="skills[index].level" />
                </div>
              </div>
            </div>
          </template>

          <button
            type="button"
            @click="skills.push({ name: '', level: 0 })"
            class="mt-2 inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition"
          >
            Skill toevoegen
          </button>
        </fieldset>

        <fieldset class="border border-purple-700 rounded-md px-4 pb-4" x-data="{openSocials: false}">
          <legend
            class="text-xl font-semibold flex items-center justify-between cursor-pointer"
            @click="openSocials = !openSocials"
          >
            <span>Socials</span>
            <svg :class="{'rotate-180': openSocials}" class="w-5 h-5 transform transition-transform text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </legend>

          <div x-show="openSocials" x-transition class="gap-4 relative bg-purple-700 border border-purple-600 p-4 rounded-md space-y-4 mt-4">
            <div>
              <label class="block text-sm font-medium text-white mb-1">LinkedIn</label>
              <input type="text"
                     name="linkedIn"
                     class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                     x-model="linkedIn"
                     placeholder="Voorbeeld: https://nl.linkedin.com/me/profile"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-white mb-1">GitHub</label>
              <input type="text"
                     name="github"
                     class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                     x-model="github"
                     placeholder="Voorbeeld: https://github.com/username"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-white mb-1">Portfolio</label>
              <input type="text"
                     name="portfolio"
                     class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                     x-model="portfolio"
                     placeholder="Voorbeeld: https://portfolio.domein.nl"
              />
            </div>
          </div>
        </fieldset>

        <fieldset class="border border-purple-700 rounded-md px-4 pb-4" x-data="{ openLanguages: false }">
          <legend class="text-xl font-semibold flex items-center justify-between cursor-pointer" @click="openLanguages = !openLanguages">
            <span>Talen</span>
            <svg :class="{'rotate-180': openLanguages}" class="w-5 h-5 transform transition-transform text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </legend>

          <div x-show="openLanguages" x-transition class="space-y-4">
            <template x-for="(lang, index) in languages" :key="index">
              <div
                class="grid grid-cols-1 md:grid-cols-2 gap-4 relative bg-purple-700 border border-purple-600 p-4 rounded-md"
                x-data="{ languageHelp: false }"
              >
                <button
                  type="button"
                  x-show="languages.length > 1"
                  @click="languages.splice(index, 1)"
                  class="absolute top-2 right-2 text-red-400 hover:text-red-600"
                  title="Verwijder deze taal"
                >
                  🗑️
                </button>

                <div>
                  <label class="block text-sm font-medium text-white mb-1">Taal</label>
                  <input
                    type="text"
                    :name="`languages[${index}][name]`"
                    class="w-full bg-purple-800 text-white placeholder-gray-300 border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                    x-model="lang.name"
                    placeholder="Bijv. Nederlands, Engels"
                    :required="lang.name || lang.level"
                  />
                </div>

                <div>
                  <label class="block text-sm font-medium text-white mb-1">Niveau</label>
                  <select
                    :name="`languages[${index}][level]`"
                    class="w-full bg-purple-800 text-white border border-purple-700 rounded-md p-2 focus:ring-2 focus:ring-purple-900 focus:outline-none"
                    x-model="lang.level"
                    :required="lang.name || lang.level"
                  >
                    <option value="" disabled selected>-- Kies niveau --</option>
                    <option value="Moedertaal">Moedertaal</option>
                    <option value="Vloeiend">Vloeiend</option>
                    <option value="Redelijk">Redelijk</option>
                    <option value="Basis">Basis</option>
                  </select>
                </div>
              </div>
            </template>

            <button
              type="button"
              @click="languages.push({ name: '', level: '' })"
              class="mt-2 inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition"
            >
              Taal toevoegen
            </button>
          </div>
        </fieldset>


        <div class="flex flex-col md:flex-row md:space-x-4 space-y-4 md:space-y-0">
          <button
            type="button"
            @click="previewCv()"
            class="w-full md:w-auto px-6 py-3 bg-blue-700 text-white rounded-md font-semibold hover:bg-blue-600 transition-colors"
          >
            Voorbeeld
          </button>

          <button
            type="submit"
            class="w-full md:w-auto px-6 py-3 bg-blue-600 text-white rounded-md font-semibold hover:bg-blue-700 transition-colors"
          >
            Genereer PDF
          </button>
        </div>

        <div class="flex flex-wrap justify-center">
          <small>Uw data wordt niet opgeslagen. Het blijft na de PDF generatie lokaal op uw apparaat.</small>
        </div>
      </form>
    </div>

    <!-- TODO: Script to own file -->
    <script>
      function cvForm() {
        return {
          first_name: '',
          last_name: '',
          email: '',
          city: '',
          phone: '',
          birthdate: '',
          job_title: '',
          profile: '',
          linkedIn: '',
          github: '',
          portfolio: '',
          template: 1,
          hobbies: [{ name: '', description: '' }],
          experiences: [{ position: '', company: '', location: '', start_date: '', end_date: '', description: '' }],
          educations: [{ degree: '', institution: '', location: '', start_date: '', end_date: '', description: '' }],
          skills: [{ name: '', level: 0 }],
          languages: [{ name: '', level: '' }],

          saveData() {
            localStorage.setItem('cv_data', JSON.stringify({
              first_name: this.first_name,
              last_name: this.last_name,
              email: this.email,
              city: this.city,
              phone: this.phone,
              birthdate: this.birthdate,
              job_title: this.job_title,
              profile: this.profile,
              template: this.template,
              hobbies: this.hobbies,
              experiences: this.experiences,
              educations: this.educations,
              skills: this.skills,
              linkedIn: this.linkedIn,
              github: this.github,
              portfolio: this.portfolio,
              languages: this.languages,
            }));
          },

          loadData() {
            const data = JSON.parse(localStorage.getItem('cv_data'));
            if (data) {
              Object.assign(this, data);
            }
          },

          clearData() {
            localStorage.removeItem('cv_data');
            this.first_name = '';
            this.last_name = '';
            this.email = '';
            this.city = '';
            this.phone = '';
            this.birthdate = '';
            this.job_title = '';
            this.profile = '';
            this.linkedIn = '';
            this.github = '';
            this.portfolio = '';
            this.template = 1;
            this.hobbies = [{ name: '', description: '' }];
            this.experiences = [{ position: '', company: '', location: '', start_date: '', end_date: '', description: '' }];
            this.educations = [{ degree: '', institution: '', location: '', start_date: '', end_date: '', description: '' }];
            this.skills = [{ name: '', level: 0 }];
          },

          fileChanged(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
            };
            reader.readAsDataURL(file);
          },

          previewCv() {
            this.saveData();
            alert('Preview functie nog implementeren');
          }
        };
      }
    </script>
  @endslot
@end
