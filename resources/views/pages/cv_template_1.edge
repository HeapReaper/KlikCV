<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CV Template</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900">
  <div class="max-w-3xl mx-auto bg-white shadow-lg rounded-xl p-8 mt-10">

    <!-- Header -->
    <div class="text-center border-b pb-6">
      <h1 class="text-4xl font-bold">{{ name }}</h1>
      <p class="text-lg text-gray-600">{{ jobTitle }}</p>
      <div class="mt-2 text-sm text-gray-500">
        johndoe@example.com • +31 612 345 678 • Amsterdam, NL
      </div>
    </div>

    <!-- About Me -->
    <div class="mt-6">
      <h2 class="text-xl font-semibold border-b pb-1 mb-2">Over mij</h2>
      <p class="text-sm text-gray-700">
        {{ aboutMe }}
      </p>
    </div>

    <!-- Experience -->
    <div class="mt-6">
      <h2 class="text-xl font-semibold border-b pb-1 mb-2">Ervaring</h2>
      <div class="space-y-4">
        <div>
          <h3 class="font-semibold">Senior Developer - TechCorp</h3>
          <p class="text-sm text-gray-500">Jan 2022 – Present | Amsterdam, NL</p>
          <ul class="list-disc pl-5 text-sm text-gray-700">
            <li>Built scalable REST APIs with AdonisJS</li>
            <li>Led migration to Tailwind-based UI system</li>
            <li>Mentored junior developers</li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold">Web Developer - DevSolutions</h3>
          <p class="text-sm text-gray-500">Mar 2019 – Dec 2021 | Rotterdam, NL</p>
          <ul class="list-disc pl-5 text-sm text-gray-700">
            <li>Maintained Laravel and Vue.js-based client portals</li>
            <li>Integrated third-party APIs (Stripe, SendGrid)</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Education -->
    <div class="mt-6">
      <h2 class="text-xl font-semibold border-b pb-1 mb-2">Education</h2>
      <div>
        <h3 class="font-semibold">BSc Computer Science - TU Delft</h3>
        <p class="text-sm text-gray-500">2015 – 2019</p>
      </div>
    </div>

    <!-- Skills -->
    <div class="mt-6">
      <h2 class="text-xl font-semibold border-b pb-1 mb-2">Skills</h2>
      <div class="flex flex-wrap gap-2 text-sm">
        <span class="bg-gray-200 px-2 py-1 rounded">JavaScript</span>
        <span class="bg-gray-200 px-2 py-1 rounded">AdonisJS</span>
        <span class="bg-gray-200 px-2 py-1 rounded">TailwindCSS</span>
        <span class="bg-gray-200 px-2 py-1 rounded">PostgreSQL</span>
        <span class="bg-gray-200 px-2 py-1 rounded">Docker</span>
        <span class="bg-gray-200 px-2 py-1 rounded">React</span>
      </div>
    </div>

    <!-- Languages -->
    <div class="mt-6">
      <h2 class="text-xl font-semibold border-b pb-1 mb-2">Languages</h2>
      <ul class="text-sm text-gray-700 list-disc pl-5">
        <li>Dutch (native)</li>
        <li>English (fluent)</li>
      </ul>
    </div>

  </div>
</body>
</html>
