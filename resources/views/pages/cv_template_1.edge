<!DOCTYPE html>
<html lang="nl" class="bg-gray-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CV met kolommen</title>
    <script src="https://cdn.tailwindcss.com"></script>

    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="font-sans text-gray-900">
    <div class="max-w-5xl mx-auto bg-white shadow-md rounded-lg p-8 mt-10 mb-10 flex flex-col md:flex-row gap-8">

      <aside class="md:w-1/4 flex flex-col items-center text-center space-y-6 border-r border-gray-200 pr-6">
        <img src="https://randomuser.me/api/portraits/men/45.jpg" alt="Foto Jan Jansen" class="rounded-full w-36 h-36 object-cover shadow-md" />

        <h1 class="text-3xl font-bold">Jan Jansen</h1>
        <p class="text-purple-700 font-semibold">Frontend Developer</p>
        <div class="text-gray-600 space-y-1">
          <p>jan.jansen@email.com</p>
          <p>Amsterdam, Nederland</p>
        </div>
      </aside>

      <main class="md:w-2/3 space-y-8">
        <section>
          <h2 class="text-2xl font-semibold border-b-2 border-purple-600 pb-1 mb-4">Profiel</h2>
          <p>
            Enthousiaste frontend developer met 5 jaar ervaring in het bouwen van responsieve websites en webapplicaties. Sterk in HTML, CSS (TailwindCSS), JavaScript en Vue.js. Passie voor gebruiksvriendelijke en toegankelijke interfaces.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold border-b-2 border-purple-600 pb-1 mb-4">Werkervaring</h2>

          <div class="mb-4">
            <div class="flex justify-between text-gray-600">
              <h3 class="text-xl font-bold">Junior Webdeveloper</h3>
              <p class="text-sm text-gray-500 mb-2">Aug 2018 - Dec 2020</p>
            </div>
            <p class="italic text-gray-600">Web Solutions — Utrecht</p>
            <ul class="list-disc list-inside space-y-1">
              <li>Bouwen en onderhouden van klantwebsites.</li>
              <li>Ondersteunen bij frontend ontwikkeling met HTML, CSS en JavaScript.</li>
              <li>Testen en debuggen van websites.</li>
            </ul>
          </div>
          <div>
            <div class="flex justify-between text-gray-600">
              <h3 class="text-xl font-bold">Junior Webdeveloper</h3>
              <p class="text-sm text-gray-500 mb-2">Aug 2018 - Dec 2020</p>
            </div>
              <p class="italic text-gray-600">Web Solutions — Utrecht</p>
            <ul class="list-disc list-inside space-y-1">
              <li>Bouwen en onderhouden van klantwebsites.</li>
              <li>Ondersteunen bij frontend ontwikkeling met HTML, CSS en JavaScript.</li>
              <li>Testen en debuggen van websites.</li>
            </ul>
          </div>
        </section>

        <section>
          <h2 class="text-2xl font-semibold border-b-2 border-purple-600 pb-1 mb-4">Opleidingen</h2>

          <div class="mb-6">
            <div class="flex justify-between text-gray-600">
              <h3 class="text-xl font-bold">Elektrotechniek</h3>
              <p class="text-sm text-gray-500">jan xxxx - dec xxxx</p>
            </div>

            <p class="italic">Twickel college</p>

          </div>
        </section>

        <!-- Vaardigheden -->
        <section>
          <h2 class="text-2xl font-semibold border-b-2 border-purple-600 pb-1 mb-4">Vaardigheden</h2>
          <div class="space-y-4 max-w-md">

            <div>
              <div class="flex justify-between mb-1">
                <span>HTML & CSS</span>
                <span>★★★★☆</span>
              </div>
              <div class="w-full bg-gray-300 rounded h-3">
                <div class="bg-purple-600 h-3 rounded" style="width: 80%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between mb-1">
                <span>JavaScript</span>
                <span>★★★☆☆</span>
              </div>
              <div class="w-full bg-gray-300 rounded h-3">
                <div class="bg-purple-600 h-3 rounded" style="width: 60%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between mb-1">
                <span>Vue.js</span>
                <span>★★★☆☆</span>
              </div>
              <div class="w-full bg-gray-300 rounded h-3">
                <div class="bg-purple-600 h-3 rounded" style="width: 60%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between mb-1">
                <span>TailwindCSS</span>
                <span>★★★★☆</span>
              </div>
              <div class="w-full bg-gray-300 rounded h-3">
                <div class="bg-purple-600 h-3 rounded" style="width: 85%"></div>
              </div>
            </div>

          </div>
        </section>
      </main>

    </div>
  </body>
</html>
