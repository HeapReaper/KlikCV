@layout.main({ title: "Home"})
  @slot('meta')
  <meta name="description" content="A welcome page made with EdgeJS">
  @endslot

  @slot('main')
    <div class="pt-4 h-full flex flex-col mt-8 min-h-screen">
      <div class="flex items-center justify-center w-full">
        <h1 class="text-2xl font-bold text-white px-2">
          Maak gratis je CV en exporteer het eenvoudig naar PDF – zonder verborgen kosten!
        </h1>
      </div>

      <div class="flex items-center justify-center w-full mt-2">
        <p class="px-2 py-2">
          Personaliseer jouw CV met moderne sjablonen die indruk maken.
          Start direct, zonder registratie of abonnement.
        </p>
      </div>

      <div class="flex items-center justify-center w-full mt-4">
        <a href="/create" class="inline-block bg-purple-700 hover:bg-purple-800 text-white text-lg font-semibold px-8 py-4 rounded-xl shadow-lg transition">
          Maak mijn CV!
        </a>
      </div>

      <div class="flex items-center justify-center w-full mt-4">
        @include('partials/template_previews')
      </div>
    </div>
  @endslot
@end
