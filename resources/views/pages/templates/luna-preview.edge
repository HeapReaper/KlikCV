<body class="font-sans text-gray-900" x-data="cvData()">

<div class="max-w-5xl mx-auto p-8 mt-10 mb-10 flex flex-col md:flex-row gap-8">
  <aside
    class="md:w-1/4 flex flex-col items-center text-center space-y-6 pr-6 py-0 bg-white rounded-lg"
  >
    <h1 class="text-3xl font-bold text-gray-800">
      <span x-text="first_name"></span> <span x-text="last_name"></span>
    </h1>

    <template x-if="profilePicture">
      <img
        :src="profilePicture"
        alt="Profielfoto"
        class="rounded-full w-36 h-36 object-cover border-4 border-purple-700 "
      />
    </template>

    <template x-if="birthdate">
      <p class="text-gray-500 text-sm italic" x-text="birthdate"></p>
    </template>

    <p class="text-purple-700 font-semibold text-xl" x-text="jobTitle"></p>

    <div class="text-gray-600 space-y-1 text-sm">
      <template x-if="email">
        <p><span class="font-semibold">Email:</span> <span x-text="email"></span></p>
      </template>

      <template x-if="city">
        <p><span class="font-semibold">Woonplaats:</span> <span x-text="city"></span></p>
      </template>

      <template x-if="phone">
        <p><span class="font-semibold">Telefoon:</span> <span x-text="phone"></span></p>
      </template>
    </div>

    <template x-if="hobbies && hobbies.length">
      <div class="mt-4 text-left w-full px-4">
        <h2 class="text-lg font-semibold text-purple-700 mb-2 pb-1">
          Hobby's & Interesses
        </h2>
        <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
          <template x-for="(hobby, index) in hobbies" :key="index">
            <li>
              <span class="font-medium" x-text="hobby.name"></span>
              <span class="text-gray-500">– <span x-text="hobby.description"></span></span>
            </li>
          </template>
        </ul>
      </div>
    </template>
  </aside>

  <main class="md:w-2/3 space-y-8">
    <section>
      <h2 class="text-2xl font-semibold pb-1 mb-4 text-purple-700 border-b border-purple-700">Profiel</h2>
      <p x-text="profile"></p>
    </section>

    <template x-if="experiences && experiences.length">
      <section>
        <h2 class="text-2xl font-semibold pb-1 mb-4 text-purple-700 border-b border-purple-700">Werkervaring</h2>
        <template x-for="(experience, index) in experiences" :key="index">
          <div class="mb-4">
            <div class="flex justify-between text-gray-600">
              <h3 class="text-xl font-bold" x-text="experience.position"></h3>
              <p class="text-sm text-gray-500 mb-2" x-text="`${experience.start_date} - ${experience.end_date}`"></p>
            </div>
            <p class="italic text-gray-600" x-text="experience.location"></p>
            <ul class="list-disc list-inside space-y-1" x-html="experience.description"></ul>
          </div>
        </template>
      </section>
    </template>

    <template x-if="educations && educations.length">
      <section>
        <h2 class="text-2xl font-semibold text-purple-700 pb-1 mb-4 border-b border-purple-700">Opleidingen</h2>
        <template x-for="(education, index) in educations" :key="index">
          <div class="mb-6">
            <div class="flex justify-between text-gray-600">
              <h3 class="text-xl font-bold" x-text="education.degree"></h3>
              <p class="text-sm text-gray-500" x-text="`${education.start_date} - ${education.end_date}`"></p>
            </div>
            <p class="italic" x-text="education.institution"></p>
            <p x-text="education.description"></p>
          </div>
        </template>
      </section>
    </template>

    <template x-if="skillSet && skillSet.length">
      <section class="mt-8">
        <h2 class="text-2xl font-bold text-purple-700 pb-2 mb-4 border-b border-purple-700">
          Vaardigheden
        </h2>
        <div class="space-y-4">
          <template x-for="(skill, index) in skillSet" :key="index">
            <div class="flex items-center justify-between bg-purple-50 rounded-md px-4 py-2">
              <span class="font-medium text-gray-800" x-text="skill.name"></span>
              <div class="space-x-1">
                <template x-for="i in 5">
                  <span :class="i <= skill.level ? 'text-yellow-400' : 'text-gray-300'" class="text-lg">★</span>
                </template>
              </div>
            </div>
          </template>
        </div>
      </section>
    </template>
  </main>
</div>
</body>
