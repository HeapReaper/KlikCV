<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900 font-sans">
<div class="max-w-5xl mx-auto bg-white shadow-lg mt-10 flex rounded-lg overflow-hidden">
  <aside class="w-full md:w-1/3 bg-blue-700 text-white p-6 flex flex-col items-center space-y-6">
    <img
      src="https://randomuser.me/api/portraits/men/75.jpg"
      alt="Profielfoto"
      class="w-32 h-32 rounded-full border-4 border-white"
    />
    <div class="text-center">
      <h1 class="text-2xl font-bold">Jouw Naam</h1>
      <p class="text-sm text-blue-200">Full-stack Developer</p>
    </div>

    <div class="w-full">
      <h2 class="text-lg font-semibold border-b border-white pb-1 mb-2">Contact</h2>
      <ul class="text-sm space-y-1">
        <li><strong>Email:</strong> jouw@email.com</li>
        <li><strong>Tel:</strong> +31 6 12345678</li>
        <li><strong>Locatie:</strong> Amsterdam</li>
        <li><strong>LinkedIn:</strong> linkedin.com/in/jouwnaam</li>
      </ul>
    </div>

    <div class="w-full">
      <h2 class="text-lg font-semibold border-b border-white pb-1 mb-2">Skills</h2>
      <ul class="flex flex-wrap gap-2 text-sm">
        <li class="bg-white text-blue-700 px-3 py-1 rounded-full">Laravel</li>
        <li class="bg-white text-blue-700 px-3 py-1 rounded-full">Vue.js</li>
        <li class="bg-white text-blue-700 px-3 py-1 rounded-full">Tailwind</li>
        <li class="bg-white text-blue-700 px-3 py-1 rounded-full">Docker</li>
        <li class="bg-white text-blue-700 px-3 py-1 rounded-full">MySQL</li>
      </ul>
    </div>

    <div class="w-full">
      <h2 class="text-lg font-semibold border-b border-white pb-1 mb-2">Talen</h2>
      <ul class="text-sm">
        <li>Nederlands – moedertaal</li>
        <li>Engels – vloeiend</li>
      </ul>
    </div>
  </aside>

  <section class="w-full md:w-2/3 p-8 space-y-6">
    <div>
      <h2 class="text-2xl font-bold border-b-2 border-blue-500 pb-1 mb-2">Profiel</h2>
      <p class="text-gray-700">
        Gedreven ontwikkelaar met focus op performance en gebruiksvriendelijkheid. Ervaren in het bouwen van schaalbare webapplicaties en API’s met Laravel, Inertia.js en moderne frontend stacks.
      </p>
    </div>

    <div>
      <h2 class="text-2xl font-bold border-b-2 border-blue-500 pb-1 mb-2">Werkervaring</h2>
      <div class="mb-4">
        <h3 class="text-lg font-semibold">Full-stack Developer – Webbedrijf BV</h3>
        <span class="text-sm text-gray-600">Jan 2022 – heden | Utrecht</span>
        <ul class="list-disc list-inside text-gray-700 mt-2">
          <li>Gebouwd aan interne klantportalen met Laravel & Vue</li>
          <li>Realtime functies met WebSockets en Redis</li>
          <li>CI/CD pipelines opgezet met GitHub Actions</li>
        </ul>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-bold border-b-2 border-blue-500 pb-1 mb-2">Opleiding</h2>
      <div>
        <h3 class="text-lg font-semibold">HBO Informatica – Hogeschool Utrecht</h3>
        <span class="text-sm text-gray-600">2017 – 2021</span>
      </div>
    </div>
  </section>
</div>
</body>
</html>
