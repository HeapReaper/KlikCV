<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans text-gray-800">
<div class="max-w-5xl mx-auto my-10 bg-white shadow-lg rounded-lg overflow-hidden">

  <header class="bg-blue-600 text-white p-6 flex flex-col md:flex-row items-center gap-6">
    <img
      src="https://randomuser.me/api/portraits/men/76.jpg"
      class="w-28 h-28 rounded-full border-4 border-white"
      alt="Profielfoto"
    />
    <div>
      <h1 class="text-3xl font-bold">Jouw Naam</h1>
      <p class="text-lg text-blue-200">Web Developer • Creative Coder</p>
    </div>
  </header>

  <div class="grid md:grid-cols-3 gap-8 p-8">
    <section class="md:col-span-2 space-y-8">
      <div>
        <h2 class="text-xl font-semibold border-b-2 border-blue-500 pb-1 mb-2">Profiel</h2>
        <p>
          Creatieve en analytische ontwikkelaar met een passie voor frontend technologieën.
          Ervaring in het ontwerpen en bouwen van schaalbare webapps met een focus op UX/UI.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold border-b-2 border-blue-500 pb-1 mb-2">Werkervaring</h2>
        <div class="mb-4">
          <h3 class="text-lg font-semibold">Frontend Developer – Pixel & Code</h3>
          <span class="text-sm text-gray-600">2021 – heden</span>
          <ul class="list-disc list-inside text-sm mt-2">
            <li>Ontwikkeling in React en Tailwind</li>
            <li>Figma designs omgezet naar pixel-perfect frontends</li>
            <li>Performance audits en optimalisaties</li>
          </ul>
        </div>
      </div>

      <div>
        <h2 class="text-xl font-semibold border-b-2 border-blue-500 pb-1 mb-2">Opleiding</h2>
        <h3 class="text-md font-semibold">HBO CMD – Hogeschool van Amsterdam</h3>
        <p class="text-sm text-gray-600">2017 – 2021</p>
      </div>
    </section>

    <aside class="space-y-8">
      <div>
        <h2 class="text-xl font-semibold border-b-2 border-blue-500 pb-1 mb-2">Contact</h2>
        <ul class="text-sm space-y-1">
          <li><strong>Email:</strong> naam@email.com</li>
          <li><strong>Tel:</strong> +31 6 87654321</li>
          <li><strong>Website:</strong> jouwsite.nl</li>
          <li><strong>Locatie:</strong> Breda, Nederland</li>
        </ul>
      </div>

      <div>
        <h2 class="text-xl font-semibold border-b-2 border-blue-500 pb-1 mb-2">Skills</h2>
        <ul class="flex flex-wrap gap-2 text-sm">
          <li class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full">Vue.js</li>
          <li class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full">Tailwind CSS</li>
          <li class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full">Figma</li>
          <li class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full">TypeScript</li>
          <li class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full">Inertia.js</li>
        </ul>
      </div>

      <div>
        <h2 class="text-xl font-semibold border-b-2 border-blue-500 pb-1 mb-2">Talen</h2>
        <ul class="text-sm">
          <li>Nederlands – moedertaal</li>
          <li>Engels – vloeiend</li>
          <li>Duits – basis</li>
        </ul>
      </div>
    </aside>
  </div>
</div>
</body>
</html>
