<!DOCTYPE html>
<html lang="nl" class="bg-gray-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CV</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="font-sans text-gray-900">
    <div class="max-w-5xl mx-auto p-8 mt-10 mb-10 flex flex-col md:flex-row gap-8">

      <aside class="md:w-1/4 flex flex-col items-center text-center space-y-6 pr-6 py-0 bg-white rounded-lg shadow-sm">
        <h1 class="text-3xl font-bold text-gray-800">
          {{ firstName }} {{ lastName }}
        </h1>

        @if(profilePicture)
          <img src="{{ profilePicture }}" alt="Profielfoto" class="rounded-full w-36 h-36 object-cover border-4 border-purple-700 shadow-md" />
        @endif

        @if (birthdate)
          <p class="text-gray-500 text-sm italic">{{ birthdate }}</p>
        @endif

        <p class="text-purple-700 font-semibold text-xl">
          {{ jobTitle }}
        </p>

        <div class="text-gray-600 space-y-1 text-sm">
          @if(email)
            <p><span class="font-semibold">Email:</span> {{ email }}</p>
          @endif

          @if(city)
            <p><span class="font-semibold">Woonplaats:</span> {{ city }}</p>
          @endif

          @if(phone)
            <p><span class="font-semibold">Telefoon:</span> {{ phone }}</p>
          @endif
        </div>

        @if(hobbies?.length)
          <div class="mt-4 text-left w-full px-4">
            <h2 class="text-lg font-semibold text-purple-700 mb-2 pb-1">Hobby's & Interesses</h2>
            <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
              @each(hobby in hobbies)
                <li>
                  <span class="font-medium">{{ hobby.name }}</span>
                  <span class="text-gray-500">– {{ hobby.description }}</span>
                </li>
              @end
            </ul>
          </div>
        @endif
      </aside>

      <main class="md:w-2/3 space-y-8">
        <section>
          <h2 class="text-2xl font-semibold border-b-2 border-purple-600 pb-1 mb-4">Profiel</h2>
          <p>
            {{ profile }}
          </p>
        </section>

        @if (workExperiences?.length > 0)
          <section>
            <h2 class="text-2xl font-semibold border-b-2 border-purple-600 pb-1 mb-4">Werkervaring</h2>
            @each(workExperience in workExperiences)
              <div class="mb-4">
                <div class="flex justify-between text-gray-600">
                  <h3 class="text-xl font-bold">{{ workExperience.position }}</h3>
                  <p class="text-sm text-gray-500 mb-2">{{ workExperience.start_date }} - {{ workExperience.end_date }}</p>
                </div>
                <p class="italic text-gray-600">{{ workExperience.location }}</p>
                <ul class="list-disc list-inside space-y-1">
                  {{ workExperience.description }}
                </ul>
              </div>
            @end
          </section>
        @endif

        @if (educations?.length > 0)
          <section>
            <h2 class="text-2xl font-semibold border-b-2 border-purple-600 pb-1 mb-4">Opleidingen</h2>
            @each(education in educations)
              <div class="mb-6">
                <div class="flex justify-between text-gray-600">
                  <h3 class="text-xl font-bold">{{ education.degree }}</h3>
                  <p class="text-sm text-gray-500">{{ education.start_date}} - {{ education.end_date}}</p>
                </div>

                <p class="italic">{{ education.institution }}</p>
                <p>
                  {{ education.description }}
                </p>
              </div>
            @end
          </section>
        @endif

        @if(skillSet && skillSet.length > 0)
          <section class="mt-8">
            <h2 class="text-2xl font-bold text-purple-700 border-b-2 pb-2 mb-4">
              Vaardigheden
            </h2>

            <div class="space-y-4">
              @each(skill in skillSet)
                <div class="flex items-center justify-between bg-purple-50 border border-purple-200 rounded-md px-4 py-2">
                  <span class="font-medium text-gray-800">{{ skill.name }}</span>

                  <div class="space-x-1">
                    @each(i in [1, 2, 3, 4, 5])
                    <span class="{{ i <= skill.level ? 'text-yellow-400' : 'text-gray-300' }} text-lg">★</span>
                    @end
                  </div>
                </div>
              @end
            </div>
          </section>
        @endif
      </main>
    </div>
  </body>
</html>
