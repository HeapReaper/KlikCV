<header class="bg-purple-800 border-b border-purple-700 shadow-md" x-data="{ mobileNav: false }">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    <div class="flex items-center space-x-4">
      <img src="/images/icons/cv2.png" alt="KlikCV logo" class="h-8 w-8">
      <h1 class="text-lg font-bold text-white">
        <a href="/" class="hover:text-purple-300 text-white">
          KlikCV
        </a>
      </h1>
    </div>

    <button id="menuToggle" class="md:hidden text-white focus:outline-none" x-on:click="mobileNav = true">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
           viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <nav id="mobileMenu"
       class="absolute top-16 left-0 w-full bg-purple-800 md:static md:block md:w-auto md:bg-transparent md:space-x-4 text-white"
       x-show="mobileNav"
       x-on:click.outside="mobileNav = false"
       x-transition
    >
      <div class="flex flex-col md:flex-row md:items-center md:space-x-4 px-6 py-4 md:p-0">
        <a href="/" class="py-2 md:py-0 hover:text-purple-300 transition">
          Home
        </a>
        <a href="/create" class="py-2 md:py-0 hover:text-purple-300 transition">
          CV maken
        </a>
        <a href="/privacy" class="py-2 md:py-0 hover:text-purple-300 transition">
          Privacy
        </a>

        <div class="relative" x-data="{ open: false }" @click.away="open = false">
          <button
            class="py-2 md:py-0 flex items-center hover:text-purple-300 transition focus:outline-none"
            x-on:click="open = !open"
            aria-haspopup="true"
            :aria-expanded="open.toString()"
          >
            Info
            <svg class="ml-1 w-4 h-4 inline-block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div
            x-show="open"
            class="absolute left-0 mt-2 w-40 bg-purple-700 rounded-md shadow-lg z-20"
            style="display: none;"
          >
            <a href="/privacy" class="block px-4 py-2 text-white hover:bg-purple-600">
              Privacy
            </a>
            <a href="/faq" class="block px-4 py-2 text-white hover:bg-purple-600">
              FAQ
            </a>
          </div>
        </div>

      </div>
    </nav>
  </div>
</header>
